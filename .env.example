# Discovery Uttarakhand - Unified Environment Guide
#
# FRONTEND VARIABLES (Frontend/.env):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
#
# BACKEND VARIABLES (backend/.env):
# NODE_ENV=production
# PORT=5000
# FRONTEND_URL=https://yourdomain.com
# MONGODB_URI=mongodb+srv://<USER>:<PASS>@cluster.mongodb.net/discovery_uttarakhand?retryWrites=true&w=majority
# JWT_SECRET=secure_secret
# CLOUDINARY_CLOUD_NAME=name
# CLOUDINARY_API_KEY=key
# CLOUDINARY_API_SECRET=secret
# OMNIROUTE_ENABLED=true
# OMNIROUTE_BASE_URL=https://omniroute.yourdomain.com/v1
# OMNIROUTE_API_KEY=key
# GEMINI_API_KEY=key
