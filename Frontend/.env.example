# Discovery Uttarakhand - Frontend Environment Variables
# In production, set this to your cloud backend URL (e.g. https://api.discoveryuttarakhand.in/api)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Optional: Map tile layer provider (CARTO Voyager default requires no API key)
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO
