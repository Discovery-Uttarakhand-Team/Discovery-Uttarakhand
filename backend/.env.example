# ==============================================================================
# DISCOVERY UTTARAKHAND — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development.
# For production, configure secrets in your cloud provider's secret manager.
# NEVER COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Security & CORS
FRONTEND_URL=http://localhost:5173

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_64_character_hex_string

# Database (MongoDB Atlas / Local MongoDB)
# For Atlas: mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/discovery_uttarakhand
MONGO_URI=mongodb://localhost:27017/discovery_uttarakhand

# Cloudinary (Media Hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Provider Architecture
# Active provider order: omniroute -> gemini -> openai -> deterministic
AI_PROVIDER=omniroute

# OmniRoute Gateway (Local or Hosted Private Cloud Gateway)
# LOCAL: http://localhost:20128/v1
# PRODUCTION: https://omniroute.yourdomain.com/v1 (or set AI_PROVIDER=gemini)
OMNIROUTE_ENABLED=true
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key
OMNIROUTE_MODEL=auto/fast

# Groq (Fast Inference Fallback)
GROQ_ENABLED=true
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Cloud Fallback)
GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Alternative Fallback)
OPENAI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# AI Agentic Runtime (node = Node.js agentService, python = LangGraph FastAPI)
AI_AGENT_RUNTIME=python
PYTHON_AI_URL=http://127.0.0.1:8000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_AGENT_SECRET=replace_with_a_secure_random_string

# Web3 / Smart Contract Verification (Hardhat Local or EVM Testnet/Mainnet)
WEB3_RPC_URL=http://127.0.0.1:8545
WEB3_ADMIN_PRIVATE_KEY=your_deployer_wallet_private_key
WEB3_PARTNER_VERIFICATION_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
WEB3_VEHICLE_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Payment Gateway (Razorpay - Staged/Disabled by default)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
