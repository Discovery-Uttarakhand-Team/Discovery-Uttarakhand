ia.org/wiki/File:View_of_Nanda_Devi_Peak_from_Gorson_Meadows.jpg", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=76251309", "extmetadata": {"DateTime": {"value": "2019-02-01 04:21:53", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "View of Nanda Devi Peak from Gorson Meadows", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Nanda Devi|Self-published work|Trekking in Uttarakhand", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "Nanda Devi Peak (7816 m) is the second highest peak in India. Nanda Devi basin was notified as a National Park in the year 1982. The core zone of the Nanda Devi National park is 625 square kilometers.  The park is approachable only by trekking. Visitors are allowed only till Dharansi campsite. The access to the park is from the village of Lata near Joshimath in the border district of Chamoli in Uttarakhand. The best option to visit the park is by joining the Interpretive Trek to Nanda Devi National Park which is offered between the months of May-June and September-October.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2006-01-01 14:24:22", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"//commons.wikimedia.org/w/index.php?title=User:Mountain_Shepherds&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Mountain Shepherds (page does not exist)\">Nanda Devi Institute of Adventure Sports and Outdoor Education</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC BY-SA 4.0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Attribution-Share Alike 4.0", "source": "commons-desc-page"}, "AttributionRe