# ============================================
# AI-Powered College Programming Lab Management System
# Environment Variables
# ============================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_programming_lab?schema=public

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- AI Service ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Service URLs ---
AI_SERVICE_URL=http://localhost:8000
CODE_EXECUTOR_URL=http://localhost:4000

# --- Backend ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:5000/api/v1